@article{diamond2016cvxpy,
author = {Diamond, Steven and Boyd, Stephen},
title = {CVXPY: a python-embedded modeling language for convex optimization},
year = {2016},
issue_date = {January 2016},
publisher = {JMLR.org},
volume = {17},
