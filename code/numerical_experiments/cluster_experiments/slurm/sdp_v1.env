# sdp_v1: sync up of the SDP sanity experiments only (sdp/, sdp_v1/, slurm/sdp_*);
# every other path, including the frozen code of the launched campaigns, is excluded.
# slurm/cluster.env: the only file you must edit. Sourced by bash (common.sh, job scripts)
# and read by the slurm skill helper. KEY=VALUE, no spaces around '='.
# Only $USER may appear in values; it is expanded on the cluster, so one committed file
# works for every member of the project.

# ssh alias from ~/.ssh/config (or "local" when running on the login node itself).
SLURM_HOST=della-gpu

# Where the project lives on the cluster. Use fast scratch storage, not $HOME.
# Example: /scratch/gpfs/GROUP/$USER/myproject
REMOTE_PROJECT_DIR=/scratch/gpfs/BSTELLATO/pranav/rand_nla_fom

# Slurm account (--account). Leave empty if you have exactly one; it is detected.
SLURM_ACCOUNT=bstellato

# Email for --mail-user (END,FAIL,TIME_LIMIT). Empty = no email.
SLURM_MAIL=

# Directory (relative to the project root) where experiments write results. `sync down` pulls it.
RESULTS_DIR=results

# Comma-separated rsync excludes for `sync up`.
RSYNC_EXCLUDES=/[!s]*,/st*,/slurm/[!s]*,/slurm/st*,__pycache__,*.pyc,.DS_Store

# Python for the remote uv venv (env_setup.sh).
PYTHON_VERSION=3.12

# Environment modules loaded before every job and by env_setup.sh, comma separated (no spaces),
# e.g. gurobi/12.0.3 for a site-licensed solver. Check names with `module avail <name>` on the
# cluster; `doctor` reports whether each one exists. Empty = none.
MODULES=
